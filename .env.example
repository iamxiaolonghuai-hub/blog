# 复制本文件为 .env.local 后按需修改

# 后端接口地址。
# 开发时默认用 /api，由 vite.config.ts 里的 proxy 代理到 Drogon（见下方 VITE_PROXY_TARGET）。
# 生产环境若前后端不同域，可填完整地址，例如 https://api.example.com/api
VITE_API_BASE=/api

# Vite 开发代理目标：你的 Drogon 服务地址（默认 8081 端口）
VITE_PROXY_TARGET=http://localhost:8081

# 设为 true 时强制使用内置示例数据，不请求后端（后端未就绪时用于演示）
VITE_USE_MOCK=false

# 本地 MySQL 开发容器使用；复制到 .env.local 后设置自己的密码
BLOG_DEV_DB_PASSWORD=replace-with-local-db-password
BLOG_DEV_ROOT_PASSWORD=replace-with-local-root-password
