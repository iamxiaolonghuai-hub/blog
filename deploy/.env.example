# 复制为 deploy/.env 后修改。此文件含密钥，不要提交到 git！
# 改动后需要重新 docker compose ... up -d 才会生效。

# ==========================================================
#  通用（任何模式都要）
# ==========================================================

# JWT 签名密钥：openssl rand -hex 32 生成
BLOG_JWT_SECRET=replace-with-openssl-rand-hex-32
DB_MODE=standalone

# ==========================================================
#  数据库连接（后端实际读取的就是这 5 个）
# ==========================================================

# 主机地址，三选一：
#   独立共享容器 → db-mysql
#   compose 自带 → mysql
#   腾讯云托管   → xxxxxx.mysql.tencentcdb.com（内网地址，需同地域同 VPC）
DB_HOST=db-mysql
DB_PORT=3306
DB_NAME=blog
DB_USER=blog
DB_PASSWORD=changeit-blog-password

# ==========================================================
#  仅当【由本项目创建 MySQL 容器】时才用下面两个：
#    docker compose -f deploy/with-db.yml ...           （compose 自带）
#    docker compose -f deploy/mysql-standalone.yml ...  （独立共享实例）
#  接腾讯云托管数据库时这两项不需要填
# ==========================================================

MYSQL_ROOT_PASSWORD=changeit-root-password
MYSQL_PASSWORD=changeit-blog-password   # 与上面的 DB_PASSWORD 保持一致
